# Copia este archivo como .env y completa los valores reales.
# El archivo .env está en .gitignore y NUNCA debe commitearse.

# Credenciales del proyecto Supabase (Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public key generada por: node scripts/generate-vapid.mjs
# Este valor es seguro de exponer en el browser.
VITE_VAPID_PUBLIC_KEY=

# (Opcional) DSN de Sentry para monitoreo de errores en producción.
# Obtener en: https://sentry.io → Settings → Projects → DSN
# Si no se configura, Sentry queda desactivado (no afecta la app).
VITE_SENTRY_DSN=
